---
import { Icon } from "astro-icon/components";
import { friendsConfig } from "../config";
import MainGridLayout from "../layouts/MainGridLayout.astro";

const getInitial = (name: string) => name.trim().charAt(0).toUpperCase();
---

<MainGridLayout title={friendsConfig.title} description={friendsConfig.description}>
    <div class="card-base px-6 py-7 md:px-9 md:py-8">
        <div class="relative mb-7 pl-4">
            <div class="absolute left-0 top-1 h-6 w-1 rounded-md bg-[var(--primary)]"></div>
            <h1 class="text-3xl font-bold text-90">{friendsConfig.title}</h1>
            <p class="mt-3 text-75">
                如果如果想要添加你的博客，可以向
                <a
                    href="https://github.com/haoyn231/haoyn231.github.io"
                    target="_blank"
                    rel="noopener"
                    class="link text-[var(--primary)]"
                >https://github.com/haoyn231/haoyn231.github.io</a>
                这个项目提 PR，具体修改
                <a
                    href="https://github.com/haoyn231/haoyn231.github.io/blob/main/src/config.ts#L83-L87"
                    target="_blank"
                    rel="noopener"
                    class="link text-[var(--primary)]"
                ><code>src/config.ts</code> 中的 <code>friendsConfig.links</code></a>。
            </p>
        </div>

        {friendsConfig.links.length > 0 ? (
            <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                {friendsConfig.links.map((friend) => (
                    <article class="group relative min-h-[8.5rem] rounded-[var(--radius-large)] bg-[var(--btn-plain-bg-hover)] p-4 transition hover:bg-[var(--btn-card-bg-hover)] active:bg-[var(--btn-card-bg-active)]">
                        <a
                            href={friend.url}
                            target="_blank"
							rel="noopener"
							aria-label={friend.name}
							class="absolute inset-0 z-0 rounded-[var(--radius-large)]"
						></a>
						<div class="pointer-events-none relative z-10 flex gap-4">
							<div class="h-16 w-16 shrink-0 overflow-hidden rounded-xl bg-[var(--btn-regular-bg)] text-[var(--btn-content)]">
								{friend.avatar ? (
									<img
                                        src={friend.avatar}
                                        alt={`${friend.name} avatar`}
                                        loading="lazy"
                                        class="h-full w-full object-cover transition group-hover:scale-105"
                                    />
                                ) : (
                                    <div class="flex h-full w-full items-center justify-center text-2xl font-bold">
                                        {getInitial(friend.name)}
                                    </div>
                                )}
                            </div>

                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <h2 class="truncate text-lg font-bold text-90 group-hover:text-[var(--primary)]">
                                        {friend.name}
                                    </h2>
                                    <Icon
                                        name="fa6-solid:arrow-up-right-from-square"
                                        class="shrink-0 text-[0.8rem] text-black/20 transition group-hover:text-[var(--primary)] dark:text-white/20"
                                    />
                                </div>
                                <p class="mt-2 line-clamp-2 text-sm leading-6 text-75">
                                    {friend.description}
                                </p>
                            </div>
                        </div>

                        {friend.rss && (
                            <a
                                href={friend.rss}
								target="_blank"
								rel="noopener"
								aria-label={`${friend.name} RSS`}
								class="btn-plain scale-animation absolute bottom-3 right-3 z-20 h-9 w-9 rounded-lg active:scale-90"
							>
                                <Icon name="material-symbols:rss-feed-rounded" class="text-[1.25rem]" />
                            </a>
                        )}
                    </article>
                ))}
            </div>
        ) : (
            <div class="rounded-[var(--radius-large)] border border-dashed border-black/10 px-6 py-10 text-center dark:border-white/[0.15]">
                <Icon name="material-symbols:link-rounded" class="mx-auto mb-3 text-4xl text-[var(--primary)]" />
                <p class="font-medium text-75">暂时还没有友链</p>
            </div>
        )}
    </div>
</MainGridLayout>
